{
  "theme": {
    "background_color": "#FFFFFF",
    "text_color": "#111827",
    "border_color": "#D1D5DB",
    "error_color": "#B91C1C"
  },
  "form_title": "Campaign Setup",
  "fields": [
    {
      "id": "campaign_name",
      "order": 1,
      "type": "TEXT",
      "subtype": "PLAIN",
      "label": "Campaign Name",
      "placeholder": "e.g., Summer Sale",
      "supporting_text": "Keep it short and memorable.",
      "max_length": 30,
      "error_message": "Name is required.",
      "required": true
    },
    {
      "id": "ad_networks",
      "order": 2,
      "type": "DROPDOWN",
      "label": "Ad Networks",
      "supporting_text": "Select one or more networks.",
      "allow_multiple": true,
      "default_values": [
        "net_meta"
      ],
      "required": true,
      "options": [
        {
          "id": "net_google",
          "label": "Google Search"
        },
        {
          "id": "net_meta",
          "label": "Meta Platforms"
        }
      ]
    },
    {
      "id": "daily_budget",
      "order": 3,
      "type": "TEXT",
      "subtype": "NUMBER",
      "label": "Daily Budget ($)",
      "required": true
    },
    {
      "id": "accept_legal",
      "order": 4,
      "type": "CHECKBOX",
      "label": "I agree to the Terms of Service.",
      "required": true,
      "metadata": {
        "Terms of Service": "https://example.com/terms",
        "clickable_text_color": "#2563EB"
      }
    },
    {
      "id": "campaign_notes",
      "order": 5,
      "type": "TEXT",
      "subtype": "MULTILINE",
      "label": "Campaign Notes",
      "placeholder": "Optional notes…",
      "max_length": 200
    },
    {
      "id": "landing_page",
      "order": 6,
      "type": "TEXT",
      "subtype": "URI",
      "label": "Landing Page URL",
      "placeholder": "https://example.com",
      "regex_pattern": "^https?://.+",
      "error_message": "Enter a valid URL starting with http:// or https://"
    },
    {
      "id": "api_key",
      "order": 7,
      "type": "TEXT",
      "subtype": "SECURE",
      "label": "API Key",
      "placeholder": "Enter secret key"
    },
    {
      "id": "enable_tracking",
      "order": 8,
      "type": "TOGGLE",
      "label": "Enable Conversion Tracking",
      "default_value": true,
      "supporting_text": "Recommended for performance campaigns."
    },
    {
      "id": "launch_date",
      "order": 99,
      "type": "DATE_PICKER",
      "label": "Launch Date"
    }
  ]
}
